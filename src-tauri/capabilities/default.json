{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window's web view may do. It also creates and places the notification windows.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://basesmall.chroniclecore.com/" },
        { "url": "https://basesmall.chroniclecore.com/zh/" },
        { "url": "https://github.com/Zaious/basesmall" },
        { "url": "https://github.com/Zaious/basesmall/*" }
      ]
    }
  ]
}
