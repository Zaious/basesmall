{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The optional windows (strike zone, bases, matchup, line score) only draw what the main window sends; they can be dragged and resized.",
  "windows": [
    "panel-zone",
    "panel-bases",
    "panel-matchup",
    "panel-linescore"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-show",
    "core:window:allow-hide"
  ]
}
